# China mirror: nginx base image from AWS public ECR (Docker Hub is unreachable
# in the China regions). Build context is the frontend/ dir (see .dockerignore),
# which contains the built dist/ after `npm run build`.
FROM public.ecr.aws/docker/library/nginx:stable-alpine

# The official nginx entrypoint runs envsubst over /etc/nginx/templates/*.template
# at container start, writing the result to /etc/nginx/conf.d/. API_HOST is
# supplied as a container env var by the ECS task definition.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY dist/ /usr/share/nginx/html/

EXPOSE 80
